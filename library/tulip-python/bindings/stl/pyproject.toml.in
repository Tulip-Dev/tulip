# Specify the build system.
[build-system]
requires = ["sip >=6.8, <7"]
build-backend = "sipbuild.api"

# Specify the PEP 566 metadata for the project.
[project]
name = "_stl"
version = "@Tulip_VERSION@"

[tool.sip.bindings._stl]
sip-file="Module.sip"

[tool.sip.project]
abi-version="@SIP_API@"
compile=false
sip-files-dir="@CMAKE_CURRENT_SOURCE_DIR@"
sip-module="@SIP_MODULE@"
